[Unit]
Description=Hunting, Blogging and Cooking
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hunting-blogging-and-cooking
ExecStart=/opt/hunting-blogging-and-cooking/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
